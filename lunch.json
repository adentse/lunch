{"type": "AdaptiveCard", "$schema": "http://adaptivecards.io/schemas/adaptive-card.json", "version": "1.4", "msteams": {"width": "Full"}, "body": [{"type": "TextBlock", "text": "Måndag lunch – Vecka 39", "weight": "Bolder", "size": "Large", "wrap": true}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Kakel.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Kakel", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Chili & myntamarinerad kcklinglårfilé med varma nudlar & yoghurtcréme<br>\nVeckans Veg: Helstekt blomkål med brynt smör, hasselnötter & picklad blomkål<br>\nVeckans Fisk: Dill & senapsfylld strömming med potatispuré, lingon & skirat smör<br>\n", "wrap": true}]}]}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Spishellen.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Spishällen", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Pankopanerad fläskkotlett med stekt potatis,skysås,samt egenslagen bea.<br>\nLulles isterband med örtstuvad potatis serveras med inlagda rödbetor.<br>\nPanerad spättafile med kokt potatis samt dansk remouladsås&citron<br>\n", "wrap": true}]}]}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Kroatorpet.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Kroatorpet", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Landhs köttbullar med gräddsås och kokt potatis, lingonsylt och pressgurka<br>\n", "wrap": true}]}]}]}