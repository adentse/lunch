{"type": "AdaptiveCard", "$schema": "http://adaptivecards.io/schemas/adaptive-card.json", "version": "1.4", "msteams": {"width": "Full"}, "body": [{"type": "TextBlock", "text": "Tisdag lunch – Vecka 42", "weight": "Bolder", "size": "Large", "wrap": true}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Kakel.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Kakel", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Baconlindad kycklingfil+é med sauterad Savoykål & potatispuré<br>\nVeckans Veg: Tortellini fyllda med spenat & ricottaost. Serveras med tomatsås, Grana Padano & färska örter<br>\nVeckans Fisk: Halstrad kapkummel med brynt smör, kapris, betor & potatispuré<br>\n", "wrap": true}]}]}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Spishellen.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Spishällen", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Spishällen raggmunk med fläsk och rårörda lingon,finns även löksås,potatis.<br>\nPasta penne med fläskfile i smakrik pepparsås toppad med riven grana padano.<br>\nStek panerad flundrafile serveras med gubbröra samt kokt potatis,citron.<br>\n", "wrap": true}]}]}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Kroatorpet.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Kroatorpet", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Dillkött på kalv med potatis och och rödbetor<br>\n", "wrap": true}]}]}]}