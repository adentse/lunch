{"type": "AdaptiveCard", "$schema": "http://adaptivecards.io/schemas/adaptive-card.json", "version": "1.4", "msteams": {"width": "Full"}, "body": [{"type": "TextBlock", "text": "Måndag lunch – Vecka 42", "weight": "Bolder", "size": "Large", "wrap": true}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Kakel.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Kakel", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Småländska isterband med skånsk senap, dillstuvad potatis & hustes inlagda rödbetor<br>\nVeckans Veg: Tortellini fyllda med spenat & ricottaost. Serveras med tomatsås, Grana Padano & färska örter<br>\nVeckans Fisk: Halstrad kapkummel med brynt smör, kapris, betor & potatispuré<br>\n", "wrap": true}]}]}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Spishellen.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Spishällen", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Spishällen black&white(fläskyttarfile&kycklingfile)klyftpotatis rödvinsky,bea.<br>\nSvartvinbärsglaserade revben med råstekt potais,viltgräddsås,äppelmos.<br>\nFisk bordelaise på torsk serveras med potatis mos samt pepparrotsås.<br>\n", "wrap": true}]}]}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Kroatorpet.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Kroatorpet", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Landhs köttbullar med potatis, gräddsås och lingon<br>\n", "wrap": true}]}]}]}