{"type": "AdaptiveCard", "$schema": "http://adaptivecards.io/schemas/adaptive-card.json", "version": "1.4", "msteams": {"width": "Full"}, "body": [{"type": "TextBlock", "text": "Torsdag lunch – Vecka 48", "weight": "Bolder", "size": "Large", "wrap": true}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Kakel.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Kakel", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Helstekt fläskkarré med inlagd gurka, gräddsky & ugnsbakad potatis<br>\nVeckans Veg: Indisk Dahl med linser, basmatiris samt tunt bröd<br>\nVeckans Fisk: Ångad torskfilé med äggsås, gröna ärtor & kokt potatis<br>\n", "wrap": true}]}]}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Spishellen.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Spishällen", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Marinerad utbankad fläskfile med rostad potais,stekt haricots verts,jägersås.<br>\nBaconlindad köttfärslimpa med kokt potatis,gräddsås,pressgurka,lingon.<br>\nLaxplanka serveras med sauterade grönsaker samt sandefjordsås.<br>\n", "wrap": true}]}]}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Kroatorpet.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Kroatorpet", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Fisk bordelaise kummelfilé med sprödbakat täcke serveras med vår goda skagenröra<br>\n", "wrap": true}]}]}]}