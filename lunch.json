{"type": "AdaptiveCard", "$schema": "http://adaptivecards.io/schemas/adaptive-card.json", "version": "1.4", "msteams": {"width": "Full"}, "body": [{"type": "TextBlock", "text": "Torsdag lunch – Vecka 36", "weight": "Bolder", "size": "Large", "wrap": true}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Kakel.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Kakel", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Ostfyllda nötfärsbiffar med ratatouille, vitlökskräm & rostad potatis<br>\nVeckans Veg: Vegetarisk lasagne med ruccolasallad & hyvlad Grana Padano<br>\nVeckans Fisk: Halstrad lax med hotellets romsås, färska örter & kokt kulpotatis<br>\n", "wrap": true}]}]}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Spishellen.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Spishällen", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Pankopanerad kycklingfile med färsk dragonsås samt ugnsbakad potatis.<br>\nFläsknoisette med krämig potatisgratäng samt grönpepparsås.<br>\nHemgjorda laxbiffar med krämig räksås samt potatismos,samt ärter.<br>\n", "wrap": true}]}]}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Kroatorpet.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Kroatorpet", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Landhs kycklingfilé med ädelostsås och tagliatelle<br>\nVeckans Veg: Pasta slungad i pesto med grillade grönsaker och grönsaksbiffar<br>\n", "wrap": true}]}]}]}