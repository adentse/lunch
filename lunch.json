{"type": "AdaptiveCard", "$schema": "http://adaptivecards.io/schemas/adaptive-card.json", "version": "1.4", "msteams": {"width": "Full"}, "body": [{"type": "TextBlock", "text": "Onsdag lunch – Vecka 36", "weight": "Bolder", "size": "Large", "wrap": true}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Kakel.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Kakel", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Dansk fläskstek med ljummen rödkål, äppelmos, gräddsky & kokt potatis<br>\nVeckans Veg: Vegetarisk lasagne med ruccolasallad & hyvlad Grana Padano<br>\nVeckans Fisk: Halstrad lax med hotellets romsås, färska örter & kokt kulpotatis<br>\n", "wrap": true}]}]}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Spishellen.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Spishällen", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Baconlindad färsbiff serveras med klyftpotatis samt god gräddig skynsås.<br>\nLångbakad karre med råstekt potatis samt krämig jägersås.<br>\nKrispig panerad flundrafile serveras med gubbröra samt kokt potatis,citron.<br>\n", "wrap": true}]}]}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Kroatorpet.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Kroatorpet", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Stekt fläsk med löksås och rårörda lingon<br>\nVeckans Veg: Pasta slungad i pesto med grillade grönsaker och grönsaksbiffar<br>\n", "wrap": true}]}]}]}