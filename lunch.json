{"type": "AdaptiveCard", "$schema": "http://adaptivecards.io/schemas/adaptive-card.json", "version": "1.4", "msteams": {"width": "Full"}, "body": [{"type": "TextBlock", "text": "Tisdag lunch – Vecka 39", "weight": "Bolder", "size": "Large", "wrap": true}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Kakel.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Kakel", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Baconlindad färsbiff med brynt lök, potatispuré & lingonsylt<br>\nVeckans Veg: Helstekt blomkål med brynt smör, hasselnötter & picklad blomkål<br>\nVeckans Fisk: Dill & senapsfylld strömming med potatispuré, lingon & skirat smör<br>\n", "wrap": true}]}]}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Spishellen.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Spishällen", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Spishällen raggmunk med fläsk och rårörda lingon,finns även löksås,potatis.<br>\nGräddstuvad pyttipanna med stekt ägg samt inlagda rödbetor.<br>\nHuset fiskgratäng med fluffigt potatismos,ärter,toppad med räkor.<br>\n", "wrap": true}]}]}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Kroatorpet.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Kroatorpet", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Raggmunk med stekt fläsk och lingon<br>\n", "wrap": true}]}]}]}