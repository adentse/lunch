{"type": "AdaptiveCard", "$schema": "http://adaptivecards.io/schemas/adaptive-card.json", "version": "1.4", "msteams": {"width": "Full"}, "body": [{"type": "TextBlock", "text": "Måndag lunch – Vecka 48", "weight": "Bolder", "size": "Large", "wrap": true}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Kakel.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Kakel", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Småländska isterband med skånsk senap, rödbeta & dillstuvad potatis<br>\nVeckans Veg: Indisk Dahl med linser, basmatiris samt tunt bröd<br>\nVeckans Fisk: Ångad torskfilé med äggsås, gröna ärtor & kokt potatis<br>\n", "wrap": true}]}]}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Spishellen.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Spishällen", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Klassisk pannbiff med stekt lök,pressgurka,ugensbakad potatis,gräddsky,lingon.<br>\nStuvad blomkål med stekt falukorv severas med kokt potatis samt rostad lök.<br>\nHavets wallenbergare serveras med potatispure,ärter,samt räk-och romsås.<br>\n", "wrap": true}]}]}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Kroatorpet.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Kroatorpet", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Ugnsbakad falukorv med lök, gurka och ost serveras med potatisstomp<br>\n", "wrap": true}]}]}]}