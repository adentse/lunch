{"type": "AdaptiveCard", "$schema": "http://adaptivecards.io/schemas/adaptive-card.json", "version": "1.4", "msteams": {"width": "Full"}, "body": [{"type": "TextBlock", "text": "Onsdag lunch – Vecka 42", "weight": "Bolder", "size": "Large", "wrap": true}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Kakel.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Kakel", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Hotellets persiljejärpar med kokt kulpotatis, rårörda lingon & krämig örtsås<br>\nVeckans Veg: Tortellini fyllda med spenat & ricottaost. Serveras med tomatsås, Grana Padano & färska örter<br>\nVeckans Fisk: Halstrad kapkummel med brynt smör, kapris, betor & potatispuré<br>\n", "wrap": true}]}]}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Spishellen.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Spishällen", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Pannbiff med stekt lök,pressgurka,ugnsbakad potatis,gräddsy,lingon.<br>\nÄlgisterband serveras med dillstuvad potatis samt inlagda rödbetor.<br>\nHavets wallenbergare på lax&torsk med potatispure,ärter,samt skagensås.<br>\n", "wrap": true}]}]}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Kroatorpet.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Kroatorpet", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Kålpudding med potatis och gräddsås<br>\n", "wrap": true}]}]}]}