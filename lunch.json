{"type": "AdaptiveCard", "$schema": "http://adaptivecards.io/schemas/adaptive-card.json", "version": "1.4", "msteams": {"width": "Full"}, "body": [{"type": "TextBlock", "text": "Onsdag lunch – Vecka 40", "weight": "Bolder", "size": "Large", "wrap": true}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Kakel.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Kakel", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Köttfärslimpa lindad i Prosciutto. Serveras med potatispuré, rostad vitlök & rosmarin<br>\nVeckans Veg: Spenat & svamplasagne med husets tomatsås. Toppas med hyvlad Grana Padano & färska örter<br>\nVeckans Fisk: Färsk lax gratinerad med Västerbottenost, serveras med Sauce verte & kokt kulpotatis<br>\n", "wrap": true}]}]}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Spishellen.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Spishällen", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Pannbiff med stekt lök,pressgukra,ugnsbakad potatis,lingon,gräddsky.<br>\nHemlagad schnitzel cordon bleu med stekt potatis,ärter,sky,bea.<br>\nHavets wallenbergare på lax&torsk med potatismos,ärter,samt citronsmör.<br>\n", "wrap": true}]}]}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Kroatorpet.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Kroatorpet", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Pannbiff med stekt lök och skysås serveras med kokt potatis<br>\n", "wrap": true}]}]}]}