{"type": "AdaptiveCard", "$schema": "http://adaptivecards.io/schemas/adaptive-card.json", "version": "1.4", "msteams": {"width": "Full"}, "body": [{"type": "TextBlock", "text": "Tisdag lunch – Vecka 40", "weight": "Bolder", "size": "Large", "wrap": true}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Kakel.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Kakel", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Fetaostgratinerad kyclingfilé med ljummen cous cous & husets tomatsås<br>\nVeckans Veg: Spenat & svamplasagne med husets tomatsås. Toppas med hyvlad Grana Padano & färska örter<br>\nVeckans Fisk: Färsk lax gratinerad med Västerbottenost, serveras med Sauce verte & kokt kulpotatis<br>\n", "wrap": true}]}]}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Spishellen.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Spishällen", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Spishällen raggmunk med fläsk och rårörda lingon,finns även löksås,potatis.<br>\nGodaste Chili con carne serveras med jasminris serveras med creme fraiche.<br>\nKrispig panerad flundrafile serveras med kokt potatis samt skagenröra.<br>\n", "wrap": true}]}]}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Kroatorpet.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Kroatorpet", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Fylld svensk bratwurst med potatismos samt senapssås<br>\n", "wrap": true}]}]}]}