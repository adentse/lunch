{"type": "AdaptiveCard", "$schema": "http://adaptivecards.io/schemas/adaptive-card.json", "version": "1.4", "msteams": {"width": "Full"}, "body": [{"type": "TextBlock", "text": "Torsdag lunch – Vecka 42", "weight": "Bolder", "size": "Large", "wrap": true}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Kakel.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Kakel", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Långbakad högrev med krispig grönkål, rödvinssås & persiljeslungad kulpotatis<br>\nVeckans Veg: Tortellini fyllda med spenat & ricottaost. Serveras med tomatsås, Grana Padano & färska örter<br>\nVeckans Fisk: Halstrad kapkummel med brynt smör, kapris, betor & potatispuré<br>\n", "wrap": true}]}]}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Spishellen.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Spishällen", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Marinerad utbankad fläskfile med rostad potatis,haricots verts,champinjonsås.<br>\nGrillad kycklingfile serveras med pitabröd,grönsaksris,tzatziki.<br>\nGodaste torsk-och räkgryta serveras med potatis samt citron aioli.<br>\n", "wrap": true}]}]}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Kroatorpet.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Kroatorpet", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Kotlettrad med timjanstekt potatis och pepparsås<br>\n", "wrap": true}]}]}]}