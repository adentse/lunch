{"type": "AdaptiveCard", "$schema": "http://adaptivecards.io/schemas/adaptive-card.json", "version": "1.4", "msteams": {"width": "Full"}, "body": [{"type": "TextBlock", "text": "Måndag lunch – Vecka 44", "weight": "Bolder", "size": "Large", "wrap": true}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Kakel.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Kakel", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Rigatoni e ragu al Forno, gratinerad rigatoni med köttfärssås. Serveras med gurksallad<br>\nVeckans Veg: Vegetarisk biff med gurkyoghurt & dagens tillbehör<br>\nVeckans Fisk: Teriyakiglacerad laxfilé med nudelwok, lime & hotellets Tomkatsusås<br>\n", "wrap": true}]}]}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Spishellen.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Spishällen", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Klassisk wallenbergare på kalvfärs med potatispure,ärter,skirat smör,lingon.<br>\nÄlgisterband serveras med dillstuvad potatis samt inlagda rödbetor.<br>\nKrisbig panerad kummelfile serveras med kokt potatis samt skagenröra.<br>\n", "wrap": true}]}]}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Kroatorpet.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Kroatorpet", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "", "wrap": true}]}]}]}