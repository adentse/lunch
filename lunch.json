{"type": "AdaptiveCard", "$schema": "http://adaptivecards.io/schemas/adaptive-card.json", "version": "1.4", "msteams": {"width": "Full"}, "body": [{"type": "TextBlock", "text": "Onsdag lunch – Vecka 41", "weight": "Bolder", "size": "Large", "wrap": true}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Kakel.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Kakel", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Plommonspäckad fläskkarré med gräddsky, husets äppelmos & kokt potatis<br>\nVeckans Veg: Indisk linsgryta med sötpotatis, myntayoghurt & Naan-bröd med vitlök<br>\nVeckans Fisk: Saffransdoftande fisk & skaldjursgryta med örtaioli<br>\n", "wrap": true}]}]}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Spishellen.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Spishällen", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Godaste köttbullarna med pressgurka,kokt potatis,grägddskysås,lingon.<br>\nKrämig pastagratäng med gorgonzolaost&chorizo serveras med ruccolasallad.<br>\nFisk&skaldjur gryta på lax&torsk med räkor,blåmusslor,potatis,citron aioli.<br>\n", "wrap": true}]}]}, {"type": "ColumnSet", "columns": [{"type": "Column", "width": "auto", "items": [{"type": "Image", "url": "http://adent.chroma.se/rest/Kroatorpet.png", "size": "Medium"}]}, {"type": "Column", "width": "stretch", "items": [{"type": "TextBlock", "text": "Kroatorpet", "weight": "Bolder", "wrap": true}, {"type": "TextBlock", "text": "Örtbakad kycklingfilé med örtsås, kokt potatis och gelé<br>\n", "wrap": true}]}]}]}